# Copy this file to .env and fill in real values before running
# `docker compose up --build`. Never commit the resulting .env file.

# --- Postgres ---
POSTGRES_USER=jobboard_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=jobboard_db
POSTGRES_PORT=5432

# --- API ---
API_PORT=3002
CORS_ORIGIN=http://localhost:5174
JWT_SECRET=CHANGE_THIS_TO_RANDOM_STRING_32_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_STRING
JWT_EXPIRES_IN=15m
ENCRYPTION_KEY=CHANGE_THIS_TO_64_HEX_CHARS_AES256_KEY
COOKIE_SECRET=CHANGE_THIS_SECURE_COOKIE_SECRET

# --- Front ---
FRONT_PORT=5174
VITE_API_URL=http://localhost:3002
