meta {
  name: Create Company
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/companies
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "sony",
    "description": "société de technologies"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3002
}

docs {
  Placeholder controller — currently no auth guard, no DTO validation,
  and no persistence (returns a static string). Update this request once
  CompanyController/CompanyService are implemented.
}
