meta {
  name: Change Password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "password123",
    "newPassword": "NewPassw0rd!123"
  }
}
