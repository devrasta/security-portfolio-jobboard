meta {
  name: Login 2FA
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/login/2fa
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "accessToken": "{{accessToken}}",
    "code": "123456"
  }
}

script:post-response {
  if (res.body && res.body.accessToken) {
    bru.setEnvVar("accessToken", res.body.accessToken);
  }
}
