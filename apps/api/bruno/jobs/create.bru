meta {
  name: Create Job
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/companies/:companyId/jobs
  body: json
  auth: bearer
}

params:path {
  companyId: 3ad4d39f-8a12-491e-8f7b-f0b371861622
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "title": "Backend Engineer",
    "location": "Paris",
    "description": "Building and maintaining the job board API."
  }
}

docs {
  Requires JwtAuthGuard + CompanyMemberGuard (no @RequiredRole, so any
  member of the company can create a job).

  Contract input is { companyId, title, location, description, status? } —
  companyId comes from the path, the rest from the body. Note: `status`
  is accepted by the contract/DTO but currently ignored by the service —
  every job is created with status DRAFT regardless of what's sent. Flag
  if PUBLISHED-on-create is expected to work.
}
