meta {
  name: Revoke Share Link
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/companies/:companyId/jobs/:jobId/share
  body: none
  auth: bearer
}

params:path {
  companyId: 3ad4d39f-8a12-491e-8f7b-f0b371861622
  jobId: replace-with-job-id
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Requires JwtAuthGuard + CompanyMemberGuard (no @RequiredRole, same as
  "Generate Share Link": any member of the company can revoke).

  Clears the job's shareToken and shareTokenExpiresAt, so any
  `${FRONTEND_URL}/jobs/shared/:shareToken` link stops working immediately
  (GET /jobs/shared/:shareToken then fails). Calling "Generate Share Link"
  again creates a brand new token.

  The job is looked up by { id: jobId, companyId }, so a job belonging to
  another company is reported as not found.

  Returns:
  - "Share link has been revoked" when a token existed;
  - "No active share link for this job" otherwise (idempotent).

  A PUBLISHED job remains reachable at /jobs/public/:jobId regardless:
  revoking only affects the token link. Unpublish the job to stop sharing it.
}
