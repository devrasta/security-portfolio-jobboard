meta {
  name: Invite Member
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/companies/:companyId/members/invite
  body: json
  auth: bearer
}

params:path {
  companyId: 3ad4d39f-8a12-491e-8f7b-f0b371861622
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "email": "replace-with-invitee-email",
    "role": "MEMBER"
  }
}

docs {
  Requires JwtAuthGuard + CompanyMemberGuard, and the caller must have the
  ADMIN role (or higher) in the company (@RequiredRole('ADMIN')).

  Contract input is { companyId, email, role } — companyId comes from the
  :companyId path param, email and role (OWNER | ADMIN | MEMBER) are sent
  in the body.

  Creates a CompanyInvite row (status PENDING, UUID token, 48h TTL) and
  sends an invitation email containing a link to
  {FRONTEND_URL}/invitations/accept?token=xxx — local SMTP (port 1025)
  must be running for the email to go through.

  Returns 404 if the company does not exist, a confirmation string on
  success.
}
