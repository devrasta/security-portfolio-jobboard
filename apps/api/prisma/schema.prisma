generator client {
  provider     = "prisma-client"
  output       = "../src/modules/prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String   @id @default(uuid())
  email                  String   @unique
  password               String
  name                   String?
  emailVerificationToken String?
  twoFactorEnabled       Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  companys      CompanyUser[]
  auditLogs    AuditLog[]
  refreshTokens RefreshToken[]
  activityLogs  ActivityLog[]
  companyInvitesSent CompanyInvite[] @relation("InvitedBy") 
  twoFactorSecret TwoFactorSecret?

  @@map("users")
  jobs Job[]
}

model RefreshToken {
  id  String @id @default(uuid())
  jti String @unique
  token String
  userId String
  tokenFamily String
  deviceId      String?
  userAgent     String?
  ipAddress     String?

  isRevoked     Boolean  @default(false)
  revokedAt     DateTime?
  revokedReason RevokedReason @default(EXPIRED)

  createdAt DateTime @default(now())
  expiresAt DateTime
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jti])
  @@index([tokenFamily])
}

enum RevokedReason {
  EXPIRED
  LOGOUT
  THEFT
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  action    ActivityAction
  ipAddress String?
  userAgent String?
  country   String?
  city      String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model TwoFactorSecret {
  id        String   @id @default(uuid())
  userId    String   @unique
  secret    String
  isEnabled Boolean  @default(false)
  backupCodes String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("two_factor_secrets")
}

enum ActivityAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  TOKEN_REFRESH
  PASSWORD_CHANGE
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  BACKUP_CODE_USED
}

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  users     CompanyUser[]
  jobs      Job[]
  invites   CompanyInvite[] 
  createdAt DateTime @default(now())
}


model CompanyUser {
  userId   String
  companyId String
  role     CompanyRole
  user     User   @relation(fields: [userId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])
  joinedAt DateTime @default(now())

  @@id([userId, companyId])
}

enum CompanyRole {
  OWNER
  ADMIN
  MEMBER
}

model CompanyInvite {
  id          String              @id @default(uuid())
  token       String              @unique
  email       String
  role        CompanyRole         @default(MEMBER)
  status      CompanyInviteStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime            @default(now())

  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User    @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([token])
  @@index([email])
  @@index([companyId])
  @@map("company_invites")
}

enum CompanyInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}
model Job {
  id          String    @id @default(uuid())
  companyId    String
  title       String
  description String
  status      JobStatus
  ownerId     String
  owner User @relation(fields: [ownerId], references: [id])
  shareToken  String?   @unique // ABAC : accès par lien
  invitees    JobInvite[]
  company      Company    @relation(fields: [companyId], references: [id])
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

enum JobStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model JobInvite {
  jobId     String
  email     String
  job       Job      @relation(fields: [jobId], references: [id])
  createdAt DateTime @default(now())

  @@id([jobId, email])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  companyId  String?
  action    String
  resource  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}