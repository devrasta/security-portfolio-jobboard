doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Company invitation
    style.
      body {
        font-family: Arial, sans-serif;
        background-color: #f9f9f9;
        margin: 0;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: auto;
        background-color: #ffffff;
        padding: 20px;
        border: 1px solid #dddddd;
      }
      .header {
        text-align: center;
        margin-bottom: 20px;
      }
      .button {
        display: inline-block;
        padding: 10px 20px;
        background-color: #4f46e5;
        color: #ffffff;
        text-decoration: none;
        border-radius: 4px;
      }
  body
    .container
      .header
        h1 You're invited!
      p Hello,
      p You have been invited to join #{companyName} on our platform.
      p
        a.button(href=invitationLink target="_blank") Accept invitation
      p This invitation link will expire in 48 hours.
      p If you weren't expecting this invitation, you can safely ignore this email.
